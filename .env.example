# ==============================================================================
# Lazy Nerds FixOps Client Manager — Environment Configuration Template
# ==============================================================================
# Copy this file to .env on your new machine and adjust variables as needed:
#   cp .env.example .env
# NEVER commit real production secrets or database passwords to version control.

# Application Environment
# Options: development, testing, production
ENVIRONMENT=development
PROJECT_NAME="Lazy Nerds FixOps Client Manager"
VERSION="1.0.0"

# Backend API Configuration
API_V1_STR=/api/v1

# Security & Cryptography
# Generate a cryptographically strong key in production: openssl rand -hex 32
SECRET_KEY=insecure-dev-secret-key-change-in-production-lazy-nerds-fixops-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
# Local Docker: postgresql+psycopg://postgres:postgres@localhost:5432/fixops_db
# Headless SQLite (for fast local dev without Postgres): sqlite:///./fixops_dev.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fixops_db

# CORS Allowed Origins (JSON array or comma-separated list)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Initial Authorized Account (Used during initial system database seed)
INITIAL_ADMIN_EMAIL=lokeshnalabothula@gmail.com
INITIAL_ADMIN_PASSWORD=change_this_to_a_strong_password_in_production
INITIAL_ADMIN_NAME="Lokesh Nalabothula"

# Frontend Internal API Proxy Destination
INTERNAL_API_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

# Scanner & Worker Execution Controls
ALLOW_LAB_TESTING=true
WORKER_DISPATCH_MODE=embedded
FIXOPS_WORKER_TOKEN=fixops_worker_secret_token_dev_2026

# AI Pentest & Model Provider Keys (Optional)
# XAI_API_KEY=your_xai_api_key_here
# SHANNON_AI_API_KEY=your_shannon_api_key_here
# SHANNON_AI_MODEL=openai:auto
# SHANNON_AI_BASE_URL=http://localhost:3002/v1
